{
	"name": "bootstrap-6-tryout",
	"version": "0.0.1",
	"description": "A test of Bootstrap version 6",
	"keywords": [
		"Bootstrap",
		"6"
	],
	"homepage": "https://github.com/Clickadelic/bootstrap-6-tryout#readme",
	"bugs": {
		"url": "https://github.com/Clickadelic/bootstrap-6-tryout/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Clickadelic/bootstrap-6-tryout.git"
	},
	"license": "ISC",
	"author": "Tobias Hopp",
	"type": "commonjs",
	"main": "index.js",
	"scripts": {
		"css-compile": "sass --quiet-deps --load-path=node_modules --style expanded --source-map --embed-sources src/assets/scss:src/assets/css",
		"css-prefix": "postcss --config postcss.config.js --replace \"src/assets/css/*.css\" \"!src/assets/css/*.min.css\"",
		"build": "npm-run-all --sequential css-compile css-prefix",
		"watch": "nodemon --watch src/assets/scss/ --ext scss --exec \"npm run build\"",
		"serve": "sirv --port 8080 --dev .",
		"start": "npm-run-all build --parallel watch serve",
		"lint": "stylelint \"src/assets/scss/**/*.scss\""
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"bootstrap": "^6.0.0-alpha.1",
		"vanilla-calendar-pro": "^3.4.0"
	},
	"devDependencies": {
		"autoprefixer": "^10.6.1",
		"nodemon": "^1.14.10",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.31",
		"postcss-cli": "^12.0.0",
		"sass": "^1.106.1",
		"sirv-cli": "^3.0.1",
		"stylelint": "^7.7.0",
		"stylelint-config-twbs-bootstrap": "^12.0.0"
	}
}
